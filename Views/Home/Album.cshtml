@{
    ViewData["Title"] = "charly";
}

<h1>Album</h1>

<section class="páginas">
    <button class="botonGrande" onclick="retrocederPagina()">Retroceder</button>
    <h3 id="numeroPagina">Pagina 1</h3>
    <button class="botonGrande" onclick="avanzarPagina()">Avanzar</button>
</section>

@{
    int num = 1;
}

@foreach (Seleccion sele in ViewBag.Selecciones)
{
    <section id=@($"pag{num}")>
        <div class="pagina">
            <h2>@sele.pais</h2>
            <p>Grupo: @sele.grupo</p>
        </div>
        <section>
            @foreach(Figurita figu in sele.Jugadores){
                if(figu.Pegada){
                    <div class="figuritas">
                        <p class="ubicacion2">N:@figu.ID</p>
                        <img src="@("/images/jugadores/" + figu.ID + ".svg")" alt="figurita" />
                    </div>
                }else{
                    <div class="figuritas">
                        <p class="ubicacion2">N:@figu.ID</p>
                        <img src="@("/images/jugadores/null.svg")" alt="figurita" />
                    </div>
                }
                
            }
        </section>
    </section>
    num++;
}