@{
    ViewData["Title"] = "charly";
}

<h1>Album</h1>

<section class="páginas">
    <button class="botonGrande" onclick="retrocederPagina()">Retroceder</button>
    <h3 id="numeroPagina">Pagina 1</h3>
    <button class="botonGrande" onclick="avanzarPagina()">Avanzar</button>
</section>

@{
    int num = 1;
}

@foreach (Seleccion sele in ViewBag.Selecciones)
{
    <section id=@($"pag{num}")>
        <div class="pagina">
            <h2>Página @num</h2>
            <p>Contenido de la página @num.</p>
        </div>
    </section>
    num++;
}