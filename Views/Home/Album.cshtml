@{
    ViewData["Title"] = "charly";
}

<h1>Album</h1>

@{
    int totalFiguritas = 864;
    int owned = 0;
    if (ViewBag.Selecciones != null)
    {
        foreach (Seleccion s in ViewBag.Selecciones)
        {
            if (s.Jugadores != null)
            {
                foreach (Figurita f in s.Jugadores)
                {
                    if (f.Pegada) { owned++; }
                }
            }
        }
    }
    var porcentaje = (int)Math.Round((owned * 100.0) / totalFiguritas);
}

<div class="progress-wrapper fondo">
    <div class="progress-label">Progreso: @owned / @totalFiguritas (@porcentaje%)</div>
    <div class="progress">
        <div class="progress-bar" style="width:@porcentaje%"></div>
    </div>
</div>
<section class="páginas">
    <button class="botonGrande" onclick="retrocederPagina()">Retroceder</button>
    <h3 id="numeroPagina">Pagina 1</h3>
    <button class="botonGrande" onclick="avanzarPagina()">Avanzar</button>
</section>

@{
    int num = 1;
}

@foreach (Seleccion sele in ViewBag.Selecciones)
{
    <section id=@($"pag{num}") class="@sele.pais" data-pais="@sele.pais">
        <div class="pagina">
            <h2>@sele.pais</h2>
            <p>Grupo: @sele.grupo</p>
        </div>
            @foreach(Figurita figu in sele.Jugadores){
                if(figu.Pegada){
                    <div class="figuritas">
                        <p class="ubicacion2">N:@figu.ID</p>
                        <img src="@("/images/jugadores/" + figu.ID + ".svg")" alt="figurita" />
                    </div>
                }else{
                    <div class="figuritas">
                        <p class="ubicacion2">N:@figu.ID</p>
                        <img src="@("/images/jugadores/null.svg")" alt="figurita" />
                    </div>
                }
                
            }
    </section>
    num++;
}